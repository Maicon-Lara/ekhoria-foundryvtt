      "weight": 1,
      "range": [
        7,
        7
      ],
      "drawn": false,
      "_id": "GHwjWaAD7dT3rqd0",
      "text": "\"O Punhal Tenebroso guarda uma verdade capaz de derrubar toda a elite de Durgrann.\" — <em>Verdade</em>",
      "documentId": null,
      "flags": {},
      "img": "icons/svg/d20-black.svg",
      "_key": "!tables.results!ZWaDiJ8blx7RwP0A.GHwjWaAD7dT3rqd0"
