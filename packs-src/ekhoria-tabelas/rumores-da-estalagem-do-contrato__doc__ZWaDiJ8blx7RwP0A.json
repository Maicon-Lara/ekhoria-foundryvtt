      "range": [
        6,
        6
      ],
      "drawn": false,
      "_id": "xT7s8llqarC0tGnn",
      "text": "\"A Tropa Sem Fim está se desfazendo: dizem que os mortos começaram a pedir para partir.\" — <em>Verdade</em>",
      "documentId": null,
      "flags": {},
      "img": "icons/svg/d20-black.svg",
      "_key": "!tables.results!ZWaDiJ8blx7RwP0A.xT7s8llqarC0tGnn"
