      "weight": 1,
      "range": [
        4,
        4
      ],
      "drawn": false,
      "_id": "aOGHKpbXOEHeJ3yf",
      "text": "\"O mapa do Cofre Central de Ferro Velho está à venda; são 80 milhões lá dentro.\" — <em>Isca</em>",
      "documentId": null,
      "flags": {},
      "img": "icons/svg/d20-black.svg",
      "_key": "!tables.results!ZWaDiJ8blx7RwP0A.aOGHKpbXOEHeJ3yf"
    },
    {
