      "weight": 1,
      "range": [
        10,
        10
      ],
      "drawn": false,
      "_id": "5SySr8zhWYc7iTVn",
      "text": "\"No deserto, ossos colossais tremeram sob as dunas. O Tarrasque vai acordar.\" — <em>Exagero</em>",
      "documentId": null,
      "flags": {},
      "img": "icons/svg/d20-black.svg",
      "_key": "!tables.results!ZWaDiJ8blx7RwP0A.5SySr8zhWYc7iTVn"
