      "weight": 1,
      "range": [
        8,
        8
      ],
      "drawn": false,
      "_id": "UWQt4fohjMT5DyLb",
      "text": "\"No Vale, quem abate uma águia ganha o direito a um pedido no Conselho dos Sete.\" — <em>Isca</em>",
      "documentId": null,
      "flags": {},
      "img": "icons/svg/d20-black.svg",
      "_key": "!tables.results!ZWaDiJ8blx7RwP0A.UWQt4fohjMT5DyLb"
